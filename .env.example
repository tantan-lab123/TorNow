# ==============================================================================
# Supabase (if not provided, the app falls back to the in-memory mock engine in dev only)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: used ONLY for Google sign-in. RLS denies it access to all tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Required in production. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Secrets (generate each with: openssl rand -hex 32)
# ==============================================================================
# Signs owner session cookies and calendar-feed tokens (min 32 chars). Required in production.
SESSION_SECRET=
# Bearer token for the reminders cron (min 16 chars). No default exists.
CRON_SECRET=

# Public App URL for links generated in notifications
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public site URL: base of the manage link in the confirmation SMS (https://your-domain, no trailing slash).
# Without it the SMS is recorded as skipped (site_url_missing) and the booking goes on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Confirmation SMS via 019sms (https://docs.019sms.co.il/sms/)
# Without these the feature is off: each booking just records a skipped SMS with the reason.
# ==============================================================================
# API token: created in the 019 UI (Settings -> API Token management). It has a fixed expiry date.
# Do NOT enable IP restriction on it (Vercel has no fixed outgoing IP).
SMS_019_API_TOKEN=
SMS_019_USERNAME=
# Sender name: English letters and digits only, up to 11 characters, verified in the 019 account.
SMS_019_SOURCE=
# Secret in the delivery-report URL registered at 019 (min 16 chars, e.g. openssl rand -hex 32):
#   https://<site>/api/webhooks/019sms/dlr?s=<this value>
SMS_019_WEBHOOK_SECRET=
# Optional: 1 sends to the /api/test endpoint of 019 (same answer, nothing is really sent).
SMS_019_DRY_RUN=

# ==============================================================================
# Operator dashboard (/superadmin)
# ==============================================================================
# Comma-separated e-mails allowed into /superadmin (Google sign-in). Empty = nobody gets in.
SUPERADMIN_EMAILS=
# Price of ONE billed SMS message in shekels, a decimal with a point (e.g. 0.009). Unset/invalid = counts only, no cost.
SMS_MESSAGE_PRICE_ILS=
